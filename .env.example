# Railway → Variables; yerelde apps/server/.env (git dışı). Hiçbiri tanımlı değilse ve NODE_ENV!=production ise kimlik KAPALI (geliştirme).
PORT=8787
NODE_ENV=production

# Paylaşımlı durum (SQLite). Railway: servis → Volumes → mount path /data; sonra:
DATA_PATH=/data/vibe.db

# Vibe stüdyosu (Claude köprüsü). Takma ad kabul edilir: VIBE-MANAGEMENT / VIBE_MANAGEMENT (Railway'de kullanılan ad)
ANTHROPIC_API_KEY=sk-ant-...

# Kimlik — oturum çerezi imzası (uzun rastgele metin; örn. `openssl rand -base64 32`)
SESSION_SECRET=

# ANA GİRİŞ: e-posta + parola. Biçim: eposta:scrypt~salt~hash (virgülle birden fazla; '~' ayraç — '$' Railway Raw Editor'da bozulur).
# Hash üret: npm run auth:hash -- <parola>
PASSWORD_USERS=f.yildizli@jurishukuk.com:scrypt~...,gulsah@jurishukuk.com:scrypt~...

# GELİŞTİRİCİ (isteğe bağlı): GitHub OAuth App → Settings → Developer settings → OAuth Apps.
# Callback URL: https://<alan-adi>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_USERS=FrhnYldzl

# Yalnız yerel geliştirme: kimliği zorla kapat
# AUTH_DISABLED=1
